{
  "name": "openai-s3-image",
  "version": "1.0.0",
  "description": "Fast image storage and generation using S3 and OpenAI.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "tsc && npm run copy-public",
    "copy-public": "copyfiles -u 1 public/**/* dist/public",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["openai", "s3", "image", "storage", "generation"],
  "author": "AlwaysHungrie",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@aws-sdk/s3-request-presigner": "^3.787.0",
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "1.4.5-lts.2",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "copyfiles": "^2.4.1"
  }
}
